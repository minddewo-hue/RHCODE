{
  "expo": {
    "name": "RHZYCODE",
    "slug": "rhzycode",
    "version": "0.1.35",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.rhzy.code",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "ai.rhzy.code",
      "versionCode": 36,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F3241"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "允许 RHZYCODE 访问相册中的图片",
          "savePhotosPermission": "允许 RHZYCODE 将生成的图片保存到相册",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许 RHZYCODE 使用相机拍摄附件",
          "photosPermission": "允许 RHZYCODE 从相册选择附件",
          "microphonePermission": false
        }
      ],
      "./plugins/with-android-local-toolchain.cjs",
      "./plugins/with-public-http-cleartext.cjs"
    ],
    "extra": {
      "updateManifestUrl": "http://218.201.210.211:8000/v1/updates/manifest"
    }
  }
}
