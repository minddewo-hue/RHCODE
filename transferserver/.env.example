# Direct public HTTP listener. This mode does not encrypt KEY or relay traffic.
RHZYCODE_TRANSFER_HOST=10.0.10.120
RHZYCODE_TRANSFER_PORT=8000
RHZYCODE_TRANSFER_TRUST_PROXY=0
RHZYCODE_TRANSFER_REQUIRE_TLS=0
RHZYCODE_TRANSFER_ALLOW_PUBLIC_HTTP=1
RHZYCODE_TRANSFER_ALLOWED_HOSTS=218.201.210.211:8000
RHZYCODE_TRANSFER_ALLOWED_ORIGINS=http://218.201.210.211:8000
RHZYCODE_TRANSFER_UPDATES_DIR=/home/analyzer/work_space/rhzycode-transfer/updates

# Direct TLS alternative:
# RHZYCODE_TRANSFER_REQUIRE_TLS=1
# RHZYCODE_TRANSFER_ALLOW_PUBLIC_HTTP=0
# RHZYCODE_TRANSFER_TLS_CERT=/etc/letsencrypt/live/transfer.example.com/fullchain.pem
# RHZYCODE_TRANSFER_TLS_KEY=/etc/letsencrypt/live/transfer.example.com/privkey.pem
